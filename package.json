    "api-directory",
    "api-pricing",
    "b2b-data",
    "data-enrichment",
    "datacircle"
  ],
  "homepage": "https://datacircle.dev",
  "bugs": {
    "url": "https://github.com/waynehamadi/openrouter-datacircle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynehamadi/openrouter-datacircle.git"
  },
  "license": "MIT",
  "author": "Datacircle <wayne@datacircle.dev> (https://datacircle.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
